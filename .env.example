# =====================================================================
# YOUTUBE RAG - FREE API CONFIGURATION
# =====================================================================
# This project is configured to work COMPLETELY FREE with no credit card needed.
# All defaults use free and open-source services.
#
# Copy this file to .env and fill in only the GROQ_API_KEY (free tier)
# =====================================================================

# =====================================================================
# LLM PROVIDER (Choose one: groq | ollama | openai | fake)
# =====================================================================

# RECOMMENDED: Groq API (FREE, no credit card, very fast)
# Get your free API key at: https://console.groq.com/
# Check available models: https://console.groq.com/docs/models
LLM_PROVIDER=groq
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
LLM_MODEL=openai/gpt-oss-20b  # Groq-supported model

# ALTERNATIVE: Ollama (FREE, fully local, no internet needed)
# Install from https://ollama.ai/ then run: ollama pull mistral
# Uncomment these lines and comment out GROQ settings above:
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL=mistral  # Other options: neural-chat, llama2, etc.

# ALTERNATIVE: OpenAI API (PAID, requires credit card)
# Not recommended unless you specifically want GPT models
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# ALTERNATIVE: Fake LLM (OFFLINE TESTING ONLY)
# LLM_PROVIDER=fake

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# =====================================================================
# EMBEDDINGS (Choose one: local | openai | hash)
# =====================================================================

# RECOMMENDED: Local embeddings (FREE, offline, fast)
# Uses sentence-transformers (included in requirements.txt)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2  # Other options: all-mpnet-base-v2, etc.
EMBEDDING_DIM=384

# ALTERNATIVE: OpenAI embeddings (PAID, not recommended)
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536

# ALTERNATIVE: Hash embeddings (OFFLINE TESTING, lower quality)
# EMBEDDING_PROVIDER=hash
# EMBEDDING_DIM=256

# =====================================================================
# RERANKING (Choose one: cross_encoder | identity | cohere)
# =====================================================================

# RECOMMENDED: Cross-encoder reranking (FREE, offline, included)
RERANKER_PROVIDER=cross_encoder
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ALTERNATIVE: Identity reranker (no reranking, just uses search order)
# RERANKER_PROVIDER=identity

# ALTERNATIVE: Cohere reranker (PAID, not recommended)
# RERANKER_PROVIDER=cohere
# COHERE_API_KEY=...

# =====================================================================
# VECTOR STORE (local storage)
# =====================================================================

VECTOR_STORE=chroma
CHROMA_DIR=chroma_db
COLLECTION_NAME=youtube_knowledge

# =====================================================================
# RETRIEVAL SETTINGS
# =====================================================================

TOP_K=5                     # Final results returned to LLM
VECTOR_TOP_K=15             # Candidates from vector search
BM25_TOP_K=15               # Candidates from BM25 search
RERANK_TOP_K=5              # Results kept after reranking
RRF_K=60                    # Reciprocal-rank-fusion constant
MIN_RELEVANCE_SCORE=0.0     # Minimum relevance threshold

# =====================================================================
# CHUNKING SETTINGS
# =====================================================================

CHUNK_SIZE=800              # Target characters per chunk
CHUNK_OVERLAP=150           # Character overlap between chunks

# =====================================================================
# RELIABILITY SETTINGS
# =====================================================================

REQUEST_TIMEOUT=60          # Timeout for API requests (seconds)
MAX_RETRIES=3               # Number of retries for failed requests
RETRY_BACKOFF=1.5           # Exponential backoff multiplier

# =====================================================================
# DATA DIRECTORIES
# =====================================================================

DATA_DIR=data
TRANSCRIPTS_DIR=data/transcripts
EVALUATION_DIR=data/evaluation

# =====================================================================
# LOGGING
# =====================================================================

LOG_LEVEL=INFO              # Options: DEBUG, INFO, WARNING, ERROR
