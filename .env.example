# ============================================================
#  YouTube Knowledge Intelligence System — configuration
#  Copy to `.env` and fill in your values. NEVER commit `.env`.
# ============================================================

# ---- LLM (OpenAI-compatible) -------------------------------
LLM_PROVIDER=openai            # openai | fake (fake = offline, no key needed)
OPENAI_API_KEY=                # required when LLM_PROVIDER/EMBEDDING_PROVIDER=openai
# OPENAI_BASE_URL=             # optional: point at any OpenAI-compatible host
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# ---- Embeddings --------------------------------------------
EMBEDDING_PROVIDER=openai      # openai | local | hash (hash = offline fallback)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=256              # only used by the hash embedder

# ---- Reranking ---------------------------------------------
RERANKER_PROVIDER=identity     # identity | cross_encoder | cohere
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# COHERE_API_KEY=

# ---- Vector store ------------------------------------------
VECTOR_STORE=chroma            # chroma | memory
CHROMA_DIR=chroma_db
COLLECTION_NAME=youtube_knowledge

# ---- Retrieval knobs ---------------------------------------
TOP_K=5
VECTOR_TOP_K=15
BM25_TOP_K=15
RERANK_TOP_K=5
RRF_K=60
MIN_RELEVANCE_SCORE=0.0

# ---- Chunking ----------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ---- Reliability -------------------------------------------
REQUEST_TIMEOUT=60
MAX_RETRIES=3
RETRY_BACKOFF=1.5

# ---- Logging -----------------------------------------------
LOG_LEVEL=INFO
